{
  "id": "champions-guild-automation",
  "title": "Champions Guild Automation",
  "description": "Fixes and additions for Coven's Automation Toolkit (CAT): spells, class features and items that CAT is missing or gets wrong. Registers itself as a CAT automation source, so CAT's Mass Apply / Update picks up every fix.",
  "version": "0.39.0",
  "authors": [
    { "name": "Champions Guild" }
  ],
  "compatibility": {
    "minimum": "14",
    "verified": "14.370",
    "maximum": "14"
  },
  "socket": true,
  "esmodules": [
    "scripts/main.js",
    "scripts/class-rules.js",
    "scripts/class-rules-p2.js",
    "scripts/class-rules-p3.js",
    "scripts/item-rules.js",
    "scripts/item-rules-p2.js",
    "scripts/item-rules-p3.js",
    "scripts/species-rules.js",
    "scripts/background-feats.js", "scripts/background-feats-p2.js", "scripts/background-feats-p3.js", "scripts/spell-rules-books.js", "scripts/spell-rules-books-p2.js", "scripts/spell-rules-books-p3.js", "scripts/feat-rules-books.js", "scripts/feat-rules-books-p2.js", "scripts/feat-rules-books-p3.js",
    "scripts/class-rules-books.js"
  ],
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": { "minimum": "6.0.0", "verified": "6.0.6" }
      }
    ],
    "requires": [
      { "id": "cat", "type": "module", "compatibility": { "minimum": "0.1.8" } },
      { "id": "midi-qol", "type": "module", "compatibility": { "minimum": "14.6.5" } },
      { "id": "dae", "type": "module", "compatibility": { "minimum": "14.6.4" } },
      { "id": "lib-wrapper", "type": "module" },
      { "id": "socketlib", "type": "module" }
    ]
  },
  "packs": [
    {
      "name": "cga-spells",
      "label": "CGA: Spells",
      "path": "packs/spells",
      "type": "Item",
      "system": "dnd5e",
      "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
    },
    {
      "name": "cga-features",
      "label": "CGA: Class, Species & Feat Features",
      "path": "packs/features",
      "type": "Item",
      "system": "dnd5e",
      "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
    },
    {
      "name": "cga-items",
      "label": "CGA: Items & Equipment",
      "path": "packs/items",
      "type": "Item",
      "system": "dnd5e",
      "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
    },
    {
      "name": "cga-monster-features",
      "label": "CGA: Monster Features",
      "path": "packs/monster-features",
      "type": "Item",
      "system": "dnd5e",
      "ownership": { "PLAYER": "NONE", "ASSISTANT": "OWNER" }
    },
    {
      "name": "cga-summons",
      "label": "CGA: Summoned Creatures",
      "path": "packs/summons",
      "type": "Actor",
      "system": "dnd5e",
      "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
    }
  ],
  "packFolders": [
    {
      "name": "Champions Guild Automation",
      "sorting": "m",
      "packs": ["cga-spells", "cga-features", "cga-items", "cga-monster-features", "cga-summons"]
    }
  ],
  "url": "https://github.com/JoshuaRogers057/champions-guild-automation",
  "manifest": "https://github.com/JoshuaRogers057/champions-guild-automation/releases/latest/download/module.json",
  "download": "https://github.com/JoshuaRogers057/champions-guild-automation/releases/download/v0.39.0/module.zip",
  "bugs": "https://github.com/JoshuaRogers057/champions-guild-automation/issues",
  "changelog": "https://github.com/JoshuaRogers057/champions-guild-automation/blob/main/CHANGELOG.md"
}
