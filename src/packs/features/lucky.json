        "useConditionText": "reaction === \"preAttack\" && await (async () => { await workflow.checkAttackAdvantage(); const t = workflow.attackRollModifierTracker; return !(t.disadvantage.isActive && !t.advantage.isActive); })()",
        "useConditionReason": "",
        "macroData": {
          "name": "Lucky: keep the Reaction",
          "command": "// Lucky (2024) imposes Disadvantage without using a Reaction, but Midi counts any\n// reaction-type use as the actor's Reaction. Give it back if this use is what spent it.\nif (rolledActivity?.id !== \"luckyDisadvant00\") return;\nconst pass = args[0]?.macroPass;\nif (pass === \"preItemRoll\") {\n  workflow.luckyReactionWasFree = !MidiQOL.hasUsedReaction(actor);\n} else if (pass === \"postActiveEffects\" && workflow.luckyReactionWasFree) {\n  // Midi marks the Reaction as the use finishes, which can land after this pass.\n  for (const wait of [500, 2000]) {\n    setTimeout(() => {\n      if (MidiQOL.hasUsedReaction(actor)) MidiQOL.removeReactionUsed(actor, true);\n    }, wait);\n  }\n}"
        },
