  "system": {
    "description": {
      "value": "<p><em>Champions Guild Automation:</em> Bonus Action, once per Long Rest (from level 3): transform for 1 minute. Once on each of your turns, a target you damage with an attack or a spell takes extra damage equal to your Proficiency Bonus (Necrotic with Necrotic Shroud, Radiant otherwise). <strong>Heavenly Wings</strong>: Fly Speed equal to your Speed. <strong>Inner Radiance</strong>: Bright Light 10 ft; at the end of each of your turns each creature within 10 ft takes Radiant damage equal to your Proficiency Bonus. <strong>Necrotic Shroud</strong>: creatures other than your allies within 10 ft make a CHA save (DC 8 + CHA modifier + Proficiency Bonus) or are Frightened until the end of your next turn.</p>",
      "chat": ""
    },
