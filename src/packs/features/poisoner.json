  "system": {
    "description": {
      "value": "<p><em>Champions Guild Automation:</em> Your Poison damage ignores Resistance to Poison. Brew Poison: set this feat's uses back to full (your Proficiency Bonus in doses) after an hour of brewing with a Poisoner's Kit and 50 GP of materials. Apply Poison (Bonus Action) coats your weapon for 1 minute; the next creature it damages makes a Constitution save (DC 8 + your higher of Dexterity or Intelligence modifier + Proficiency Bonus) or takes 2d8 Poison damage and is Poisoned until the end of your next turn.</p>",
      "chat": ""
    },
