      "macro": {
        "name": "Toll the Dead",
        "img": "icons/magic/water/orb-ice-glow.webp",
        "type": "script",
        "scope": "global",
        "command": "const version = \"13.0.52\";\ntry {\n    if (args[0].macroPass === \"preDamageRoll\") {\n        const target = await fromUuid(args[0].targetUuids[0]);\n        const needsD12 = target.actor.system.attributes.hp.value < target.actor.system.attributes.hp.max;\n        if (needsD12) {\n            rolledActivity.damage.parts[0].denomination = 12;\n        } else {\n            rolledActivity.damage.parts[0].denomination = 8;\n        }\n    }\n} catch (err) {\n    console.error(`${args[0].itemData.name} - Toll The Dead ${version}`, err);\n}",
        "author": "Zl1BOUaPLwDEujaL",
        "_id": null,
        "flags": {}
      }
    },
