{
  "name": "Spirit Lantern",
  "system": {
    "description": {
      "value": "<p><em>Champions Guild Automation:</em> A ghostly lantern hovers over you, shedding Dim Light 60 ft for 10 minutes. When an enemy dies in that light, a soul fragment flies into it (counted automatically on the spell's uses, up to your spellcasting modifier; they vanish when the spell ends). As a Bonus Action, expend one: <strong>Drain Life</strong> - a creature within 60 ft makes a CON save, 4d8 + your modifier Necrotic damage, half on a success; <strong>Repair Undead</strong> - an Undead within 60 ft regains 4d8 + your modifier Hit Points; <strong>Ward Ally</strong> - attacks against a creature within 60 ft have Disadvantage until the start of your next turn.</p>",
      "chat": ""
    },
