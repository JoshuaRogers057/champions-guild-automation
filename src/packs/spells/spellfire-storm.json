{
  "name": "Spellfire Storm",
  "system": {
    "description": {
      "value": "<p><em>Champions Guild Automation:</em> A 20-ft-radius, 20-ft-high Cylinder of spellfire (Bright Light) within 60 ft. Each creature in it when it appears, entering it for the first time on a turn, or ending its turn there makes a CON save: 4d10 Radiant damage, half on a success (once per turn; your allies are unaffected). Whenever a creature in the Cylinder casts a spell, it makes a CON save against your spell save DC or the spell dissipates with no effect, and a spell slot isn't expended.</p>",
      "chat": ""
    },
